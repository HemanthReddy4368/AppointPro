@model IEnumerable<AppointPro.Models.Doctor>
@{
    ViewData["Title"] = "Doctors";
}

<div class="admin-container glass-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 mb-1">Doctors</h1>
            <p class="text-muted">Manage doctor profiles</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-plus-circle"></i> Add Doctor
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Specialization</th>
                    <th>Hospital</th>
                    <th>Fee</th>
                    <th>Rating</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doctor in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(doctor.ProfilePicture))
                                {
                                    <img src="@doctor.ProfilePicture" alt="@doctor.Name" style="width:36px;height:36px;border-radius:8px;object-fit:cover;" />
                                }
                                <span class="fw-medium">@doctor.Name</span>
                            </div>
                        </td>
                        <td>@doctor.Specialization</td>
                        <td>@doctor.Hospital?.Name</td>
                        <td>
                            @if (doctor.ConsultationFee.HasValue)
                            {
                                @doctor.ConsultationFee.Value.ToString("C")
                            }
                        </td>
                        <td>
                            @if (doctor.Rating.HasValue)
                            {
                                <span class="badge bg-success">@doctor.Rating.Value.ToString("0.0")</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@doctor.DoctorId" class="btn btn-sm btn-outline-primary me-1">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@doctor.DoctorId" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .admin-container {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 0 20px rgba(0,0,0,0.05);
    }
    .glass-card {
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(8px);
        border-radius: 1.5rem;
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    }
    .btn-primary {
        background: linear-gradient(135deg, #4f46e5, #0ea5e9);
        border: none;
        font-weight: 500;
    }
    .btn-primary:hover {
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.2);
    }
</style>