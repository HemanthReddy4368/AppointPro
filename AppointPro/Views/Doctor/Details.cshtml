@model AppointPro.Models.Doctor
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-lg border-0 rounded-4 glass-card">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2 class="fw-bold mb-0">Doctor Details</h2>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.DoctorId" class="btn btn-outline-primary me-2">
                                <i class="bi bi-pencil me-2"></i>Edit
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Back
                            </a>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 text-center mb-4 mb-md-0">
                            @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                            {
                                <img src="@Model.ProfilePicture" alt="@Model.Name" class="img-fluid rounded-circle mb-3" style="width:180px;height:180px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width:180px;height:180px;">
                                    <i class="bi bi-person-circle text-secondary" style="font-size:5rem;"></i>
                                </div>
                            }
                            <h3 class="fw-bold mb-1">@Model.Name</h3>
                            <p class="text-primary mb-1">@Model.Specialization</p>
                            @if (Model.Rating.HasValue)
                            {
                                <div class="d-flex justify-content-center align-items-center mb-2">
                                    <span class="badge bg-success me-2">@Model.Rating.Value.ToString("0.0")</span>
                                    <div class="text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Floor(Model.Rating.Value))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else if (i - 0.5 <= Model.Rating.Value)
                                            {
                                                <i class="bi bi-star-half"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Email</label>
                                        <div class="fw-medium">@Model.Email</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Phone</label>
                                        <div class="fw-medium">@Model.PhoneNumber</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Hospital</label>
                                        <div class="fw-medium">@Model.Hospital?.Name</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Consultation Fee</label>
                                        <div class="fw-medium">
                                            @if (Model.ConsultationFee.HasValue)
                                            {
                                                @Model.ConsultationFee.Value.ToString("C")
                                            }
                                            else
                                            {
                                                <span>Not specified</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Qualifications</label>
                                        <div class="fw-medium">@Model.Qualifications</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Languages</label>
                                        <div class="fw-medium">@Model.LanguagesSpoken</div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="mb-3">
                                        <label class="form-label text-muted small">Bio</label>
                                        <div>@Model.Bio</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(8px);
        border-radius: 1.5rem;
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    }
</style>