@model AppointPro.Models.Doctor
@{
    ViewData["Title"] = "Delete Doctor";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0 rounded-4 glass-card">
                <div class="card-body p-5 text-center">
                    <h2 class="fw-bold mb-3 text-danger">Delete Doctor</h2>
                    <p class="mb-4">Are you sure you want to delete <strong>@Model.Name</strong>?</p>
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="DoctorId" />
                        <button type="submit" class="btn btn-danger btn-lg me-2">
                            <i class="bi bi-trash me-2"></i>Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(8px);
        border-radius: 1.5rem;
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    }
    .btn-danger {
        background: linear-gradient(135deg, #ef4444, #f87171);
        border: none;
        font-weight: 500;
    }
    .btn-danger:hover {
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
    }
</style>