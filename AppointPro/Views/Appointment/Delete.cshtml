@model AppointPro.Models.Appointment
@{
    ViewData["Title"] = "Delete Appointment";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-lg border-0 rounded-4 glass-card">
                <div class="card-body p-5 text-center">
                    <h2 class="fw-bold mb-3 text-danger">Delete Appointment</h2>
                    <p class="mb-4">Are you sure you want to delete this appointment?</p>

                    <div class="text-start mb-4">
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Doctor:</div>
                            <div class="col-8 fw-medium">@Model.Doctor?.Name</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Hospital:</div>
                            <div class="col-8 fw-medium">
                                @if (Model.Doctor?.Hospital != null)
                                {
                                    @Model.Doctor.Hospital.Name
                                }
                                else
                                {
                                    <span class="text-muted">Not assigned</span>
                                }
                            </div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Date:</div>
                            <div class="col-8 fw-medium">@Model.AppointmentDate.ToString("MMM dd, yyyy h:mm tt")</div>
                        </div>
                        <div class="row mb-2">
                            <div class="col-4 text-muted">Status:</div>
                            <div class="col-8 fw-medium">@Model.Status</div>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Notes))
                        {
                            <div class="row mb-2">
                                <div class="col-4 text-muted">Notes:</div>
                                <div class="col-8">@Model.Notes</div>
                            </div>
                        }
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="AppointmentId" />
                        <button type="submit" class="btn btn-danger btn-lg me-2">
                            <i class="bi bi-trash me-2"></i>Delete
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .glass-card {
        background: rgba(255,255,255,0.85);
        backdrop-filter: blur(8px);
        border-radius: 1.5rem;
        box-shadow: 0 8px 32px rgba(0,0,0,0.08);
    }

    .btn-danger {
        background: linear-gradient(135deg, #ef4444, #f87171);
        border: none;
        font-weight: 500;
    }

        .btn-danger:hover {
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2);
        }
</style>