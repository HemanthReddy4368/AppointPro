@model IEnumerable<AppointPro.Models.Appointment>
@using AppointPro.Models

@{
    ViewData["Title"] = "Manage Appointments";
    Layout = "_DashboardLayout";

    var doctor = ViewBag.Doctor as AppointPro.Models.Doctor;

    // Group appointments by status
    var scheduledAppointments = Model.Where(a => a.Status == AppointmentStatus.Scheduled).OrderBy(a => a.AppointmentDate).ToList();
    var completedAppointments = Model.Where(a => a.Status == AppointmentStatus.Completed).OrderByDescending(a => a.AppointmentDate).ToList();
    var cancelledAppointments = Model.Where(a => a.Status == AppointmentStatus.Cancelled || a.Status == AppointmentStatus.NoShow).OrderByDescending(a => a.AppointmentDate).ToList();

    // Get today's date for highlighting
    var today = DateTime.Today;
}

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-gradient-primary border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2 class="text-white mb-1">Manage Appointments</h2>
                            <p class="text-white opacity-8 mb-0">
                                View and manage all your patient appointments
                            </p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a href="#" class="btn btn-light px-4" data-bs-toggle="modal" data-bs-target="#filterModal">
                                <i class="bi bi-funnel me-2"></i>Filter Appointments
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Appointment Tabs -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white p-0">
            <ul class="nav nav-tabs" id="appointmentTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active px-4 py-3" id="scheduled-tab" data-bs-toggle="tab" data-bs-target="#scheduled" type="button" role="tab" aria-controls="scheduled" aria-selected="true">
                        Scheduled <span class="badge bg-primary ms-2">@scheduledAppointments.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link px-4 py-3" id="completed-tab" data-bs-toggle="tab" data-bs-target="#completed" type="button" role="tab" aria-controls="completed" aria-selected="false">
                        Completed <span class="badge bg-success ms-2">@completedAppointments.Count</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link px-4 py-3" id="cancelled-tab" data-bs-toggle="tab" data-bs-target="#cancelled" type="button" role="tab" aria-controls="cancelled" aria-selected="false">
                        Cancelled <span class="badge bg-danger ms-2">@cancelledAppointments.Count</span>
                    </button>
                </li>
            </ul>
        </div>
        <div class="card-body p-0">
            <div class="tab-content" id="appointmentTabsContent">
                <!-- Scheduled Appointments Tab -->
                <div class="tab-pane fade show active" id="scheduled" role="tabpanel" aria-labelledby="scheduled-tab">
                    @if (scheduledAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-3">Patient</th>
                                        <th>Date & Time</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                        <th class="text-end pe-3">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in scheduledAppointments)
                                    {
                                        var isToday = appointment.AppointmentDate.Date == today;
                                        <tr class="@(isToday ? "bg-light" : "")">
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(appointment.Patient.ProfilePicture))
                                                    {
                                                        <img src="@appointment.Patient.ProfilePicture" class="rounded-circle" width="40" height="40" alt="Patient">
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                                            <i class="bi bi-person"></i>
                                                        </div>
                                                    }
                                                    <div class="ms-3">
                                                        <p class="fw-bold mb-0">@appointment.Patient.Name</p>
                                                        <p class="text-muted mb-0">
                                                            @(appointment.Patient.Gender != null ? appointment.Patient.Gender : "")
                                                            @if (appointment.Patient.DateOfBirth != null)
                                                            {
                                                                var age = DateTime.Today.Year - appointment.Patient.DateOfBirth.Value.Year;
                                                                if (appointment.Patient.DateOfBirth.Value.Date > DateTime.Today.AddYears(-age)) age--;
                                                                <span>, @age yrs</span>
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="fw-normal mb-0">
                                                    @appointment.AppointmentDate.ToString("MMM d, yyyy")
                                                    @if (isToday)
                                                    {
                                                        <span class="badge bg-primary ms-1">Today</span>
                                                    }
                                                </p>
                                                <p class="text-muted mb-0">@appointment.AppointmentDate.ToString("h:mm tt")</p>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary">@appointment.Status</span>
                                            </td>
                                            <td>
                                                <p class="text-muted mb-0 text-truncate" style="max-width: 200px;">
                                                    @(string.IsNullOrEmpty(appointment.Notes) ? "No notes" : appointment.Notes)
                                                </p>
                                            </td>
                                            <td class="text-end pe-3">
                                                <a asp-controller="DoctorDashboard" asp-action="AppointmentDetails" asp-route-id="@appointment.AppointmentId" class="btn btn-sm btn-outline-primary me-1" title="View Details">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-success me-1" data-bs-toggle="modal" data-bs-target="#updateStatusModal" data-appointment-id="@appointment.AppointmentId" title="Update Status">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                        <i class="bi bi-three-dots-vertical"></i>
                                                    </button>
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#updateStatusModal" data-appointment-id="@appointment.AppointmentId">Update Status</a></li>
                                                        <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#addNotesModal" data-appointment-id="@appointment.AppointmentId">Add Notes</a></li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <form asp-controller="DoctorDashboard" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                                <input type="hidden" name="id" value="@appointment.AppointmentId" />
                                                                <input type="hidden" name="status" value="@AppointmentStatus.Cancelled" />
                                                                <button type="submit" class="dropdown-item text-danger">Cancel Appointment</button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-muted">No scheduled appointments found.</p>
                        </div>
                    }
                </div>

                <!-- Completed Appointments Tab -->
                <div class="tab-pane fade" id="completed" role="tabpanel" aria-labelledby="completed-tab">
                    @if (completedAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-3">Patient</th>
                                        <th>Date & Time</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                        <th class="text-end pe-3">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in completedAppointments)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(appointment.Patient.ProfilePicture))
                                                    {
                                                        <img src="@appointment.Patient.ProfilePicture" class="rounded-circle" width="40" height="40" alt="Patient">
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                                            <i class="bi bi-person"></i>
                                                        </div>
                                                    }
                                                    <div class="ms-3">
                                                        <p class="fw-bold mb-0">@appointment.Patient.Name</p>
                                                        <p class="text-muted mb-0">
                                                            @(appointment.Patient.Gender != null ? appointment.Patient.Gender : "")
                                                            @if (appointment.Patient.DateOfBirth != null)
                                                            {
                                                                var age = DateTime.Today.Year - appointment.Patient.DateOfBirth.Value.Year;
                                                                if (appointment.Patient.DateOfBirth.Value.Date > DateTime.Today.AddYears(-age)) age--;
                                                                <span>, @age yrs</span>
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="fw-normal mb-0">@appointment.AppointmentDate.ToString("MMM d, yyyy")</p>
                                                <p class="text-muted mb-0">@appointment.AppointmentDate.ToString("h:mm tt")</p>
                                            </td>
                                            <td>
                                                <span class="badge bg-success">@appointment.Status</span>
                                            </td>
                                            <td>
                                                <p class="text-muted mb-0 text-truncate" style="max-width: 200px;">
                                                    @(string.IsNullOrEmpty(appointment.Notes) ? "No notes" : appointment.Notes)
                                                </p>
                                            </td>
                                            <td class="text-end pe-3">
                                                <a asp-controller="DoctorDashboard" asp-action="AppointmentDetails" asp-route-id="@appointment.AppointmentId" class="btn btn-sm btn-outline-primary me-1" title="View Details">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#addNotesModal" data-appointment-id="@appointment.AppointmentId" title="Add Notes">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-check-circle text-muted" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-muted">No completed appointments found.</p>
                        </div>
                    }
                </div>

                <!-- Cancelled Appointments Tab -->
                <div class="tab-pane fade" id="cancelled" role="tabpanel" aria-labelledby="cancelled-tab">
                    @if (cancelledAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-3">Patient</th>
                                        <th>Date & Time</th>
                                        <th>Status</th>
                                        <th>Notes</th>
                                        <th class="text-end pe-3">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in cancelledAppointments)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrEmpty(appointment.Patient.ProfilePicture))
                                                    {
                                                        <img src="@appointment.Patient.ProfilePicture" class="rounded-circle" width="40" height="40" alt="Patient">
                                                    }
                                                    else
                                                    {
                                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                                            <i class="bi bi-person"></i>
                                                        </div>
                                                    }
                                                    <div class="ms-3">
                                                        <p class="fw-bold mb-0">@appointment.Patient.Name</p>
                                                        <p class="text-muted mb-0">
                                                            @(appointment.Patient.Gender != null ? appointment.Patient.Gender : "")
                                                            @if (appointment.Patient.DateOfBirth != null)
                                                            {
                                                                var age = DateTime.Today.Year - appointment.Patient.DateOfBirth.Value.Year;
                                                                if (appointment.Patient.DateOfBirth.Value.Date > DateTime.Today.AddYears(-age)) age--;
                                                                <span>, @age yrs</span>
                                                            }
                                                        </p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <p class="fw-normal mb-0">@appointment.AppointmentDate.ToString("MMM d, yyyy")</p>
                                                <p class="text-muted mb-0">@appointment.AppointmentDate.ToString("h:mm tt")</p>
                                            </td>
                                            <td>
                                                <span class="badge bg-danger">@appointment.Status</span>
                                            </td>
                                            <td>
                                                <p class="text-muted mb-0 text-truncate" style="max-width: 200px;">
                                                    @(string.IsNullOrEmpty(appointment.Notes) ? "No notes" : appointment.Notes)
                                                </p>
                                            </td>
                                            <td class="text-end pe-3">
                                                <a asp-controller="DoctorDashboard" asp-action="AppointmentDetails" asp-route-id="@appointment.AppointmentId" class="btn btn-sm btn-outline-primary me-1" title="View Details">
                                                    <i class="bi bi-file-earmark-text"></i>
                                                </a>
                                                <form asp-controller="DoctorDashboard" asp-action="UpdateAppointmentStatus" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@appointment.AppointmentId" />
                                                    <input type="hidden" name="status" value="@AppointmentStatus.Scheduled" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Reschedule">
                                                        <i class="bi bi-arrow-repeat"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-x-circle text-muted" style="font-size: 3rem;"></i>
                            <p class="mt-3 text-muted">No cancelled appointments found.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Status Update Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-labelledby="updateStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateStatusModalLabel">Update Appointment Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="DoctorDashboard" asp-action="UpdateAppointmentStatus" method="post">
                <div class="modal-body">
                    <input type="hidden" id="statusAppointmentId" name="id" />
                    <div class="mb-3">
                        <label for="appointmentStatus" class="form-label">Status</label>
                        <select class="form-select" id="appointmentStatus" name="status">
                            @foreach (var status in Enum.GetValues(typeof(AppointmentStatus)))
                            {
                                <option value="@status">@status</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="statusNotes" class="form-label">Notes (Optional)</label>
                        <textarea class="form-control" id="statusNotes" name="notes" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Status</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add Notes Modal -->
<div class="modal fade" id="addNotesModal" tabindex="-1" aria-labelledby="addNotesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addNotesModalLabel">Add Appointment Notes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="DoctorDashboard" asp-action="AddAppointmentNotes" method="post">
                <div class="modal-body">
                    <input type="hidden" id="notesAppointmentId" name="id" />
                    <div class="mb-3">
                        <label for="appointmentNotes" class="form-label">Notes</label>
                        <textarea class="form-control" id="appointmentNotes" name="notes" rows="5" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Notes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Filter Modal -->
<div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="filterModalLabel">Filter Appointments</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="DoctorDashboard" asp-action="Appointments" method="get">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="dateFrom" class="form-label">Date From</label>
                        <input type="date" class="form-control" id="dateFrom" name="dateFrom">
                    </div>
                    <div class="mb-3">
                        <label for="dateTo" class="form-label">Date To</label>
                        <input type="date" class="form-control" id="dateTo" name="dateTo">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="Scheduled" id="statusScheduled" name="statuses">
                            <label class="form-check-label" for="statusScheduled">
                                Scheduled
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="Completed" id="statusCompleted" name="statuses">
                            <label class="form-check-label" for="statusCompleted">
                                Completed
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="Cancelled" id="statusCancelled" name="statuses">
                            <label class="form-check-label" for="statusCancelled">
                                Cancelled
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="NoShow" id="statusNoShow" name="statuses">
                            <label class="form-check-label" for="statusNoShow">
                                No Show
                            </label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="patientSearch" class="form-label">Patient Name</label>
                        <input type="text" class="form-control" id="patientSearch" name="patientName" placeholder="Search by patient name">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Apply Filters</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Handle status update modal
            var updateStatusModal = document.getElementById('updateStatusModal');
            if (updateStatusModal) {
                updateStatusModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var appointmentId = button.getAttribute('data-appointment-id');
                    var appointmentIdInput = updateStatusModal.querySelector('#statusAppointmentId');
                    appointmentIdInput.value = appointmentId;
                });
            }

            // Handle notes modal
            var addNotesModal = document.getElementById('addNotesModal');
            if (addNotesModal) {
                addNotesModal.addEventListener('show.bs.modal', function (event) {
                    var button = event.relatedTarget;
                    var appointmentId = button.getAttribute('data-appointment-id');
                    var appointmentIdInput = addNotesModal.querySelector('#notesAppointmentId');
                    appointmentIdInput.value = appointmentId;
                });
            }
        });
    </script>
}