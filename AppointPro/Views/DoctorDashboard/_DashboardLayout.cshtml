<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppointPro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --primary: #4e73df;
            --primary-dark: #224abe;
            --secondary: #858796;
            --success: #1cc88a;
            --info: #36b9cc;
            --warning: #f6c23e;
            --danger: #e74a3b;
            --light: #f8f9fc;
            --dark: #5a5c69;
            --sidebar-width: 250px;
            --sidebar-collapsed-width: 70px;
            --topbar-height: 70px;
        }

        body {
            font-family: 'Nunito', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: var(--light);
            overflow-x: hidden;
        }

        /* Layout */
        .layout-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: var(--sidebar-width);
            background: linear-gradient(180deg, var(--primary) 0%, var(--primary-dark) 100%);
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            z-index: 100;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
        }

        .sidebar-collapsed .sidebar {
            width: var(--sidebar-collapsed-width);
        }

        .sidebar-header {
            height: var(--topbar-height);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .sidebar-logo {
            font-size: 1.25rem;
            font-weight: 700;
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .sidebar-logo i {
            font-size: 1.5rem;
            margin-right: 0.75rem;
        }

        .sidebar-collapsed .sidebar-logo span {
            display: none;
        }

        .sidebar-menu {
            padding: 1rem 0;
            list-style: none;
            margin: 0;
        }

        .sidebar-item {
            margin-bottom: 0.25rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            padding: 0.75rem 1.5rem;
            color: rgba(255, 255, 255, 0.8);
            text-decoration: none;
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }

        .sidebar-link:hover, .sidebar-link.active {
            color: white;
            background-color: rgba(255, 255, 255, 0.1);
            border-left-color: white;
        }

        .sidebar-link i {
            font-size: 1.1rem;
            min-width: 1.75rem;
        }

        .sidebar-collapsed .sidebar-link span {
            display: none;
        }

        .sidebar-divider {
            height: 0;
            margin: 1rem 0;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
        }

        .sidebar-heading {
            padding: 0 1.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.5);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .sidebar-collapsed .sidebar-heading {
            display: none;
        }

        .sidebar-toggle {
            position: absolute;
            bottom: 1rem;
            left: 50%;
            transform: translateX(-50%);
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.1);
            color: rgba(255, 255, 255, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            border: none;
        }

        .sidebar-toggle:hover {
            background-color: rgba(255, 255, 255, 0.2);
            color: white;
        }

        /* Content */
        .content {
            flex: 1;
            margin-left: var(--sidebar-width);
            transition: all 0.3s ease;
        }

        .sidebar-collapsed .content {
            margin-left: var(--sidebar-collapsed-width);
        }

        /* Topbar */
        .topbar {
            height: var(--topbar-height);
            background-color: white;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.05);
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            position: sticky;
            top: 0;
            z-index: 99;
        }

        .mobile-toggle {
            display: none;
            font-size: 1.5rem;
            color: var(--secondary);
            cursor: pointer;
            margin-right: 1rem;
            background: none;
            border: none;
        }

        .topbar-search {
            flex: 1;
            max-width: 400px;
            margin-right: auto;
        }

        .topbar-search .input-group {
            border-radius: 2rem;
            overflow: hidden;
        }

        .topbar-search input {
            border-right: none;
            padding-left: 1rem;
        }

        .topbar-search .btn {
            border-left: none;
            background-color: white;
            color: var(--primary);
        }

        .topbar-divider {
            width: 0;
            border-right: 1px solid #e3e6f0;
            height: 2rem;
            margin: 0 1rem;
        }

        .topbar-nav {
            display: flex;
            align-items: center;
        }

        .topbar-item {
            position: relative;
            margin-left: 0.5rem;
        }

        .topbar-link {
            color: var(--secondary);
            font-size: 1.1rem;
            padding: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            width: 2.5rem;
            height: 2.5rem;
            transition: all 0.3s ease;
        }

        .topbar-link:hover {
            background-color: var(--light);
            color: var(--primary);
        }

        .badge-counter {
            position: absolute;
            top: 0;
            right: 0;
            transform: translate(25%, -25%);
            font-size: 0.6rem;
            padding: 0.25rem 0.4rem;
        }

        .user-dropdown {
            display: flex;
            align-items: center;
            cursor: pointer;
        }

        .user-avatar {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 0.75rem;
        }

        .user-info {
            display: flex;
            flex-direction: column;
        }

        .user-name {
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--dark);
        }

        .user-role {
            font-size: 0.75rem;
            color: var(--secondary);
        }

        /* Main content */
        .main-content {
            padding: 1.5rem;
        }

        /* Footer */
        .footer {
            background-color: white;
            padding: 1.5rem;
            text-align: center;
            font-size: 0.85rem;
            color: var(--secondary);
            border-top: 1px solid #e3e6f0;
        }

        /* Responsive */
        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(-100%);
                box-shadow: none;
            }

            .content {
                margin-left: 0;
            }

            .mobile-menu-open .sidebar {
                transform: translateX(0);
                box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            }

            .mobile-toggle {
                display: block;
            }

            .user-info {
                display: none;
            }

            .topbar-search {
                display: none;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="layout-wrapper" id="layoutWrapper">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a href="/" class="sidebar-logo">
                    <i class="bi bi-hospital"></i>
                    <span>AppointPro</span>
                </a>
            </div>

            <ul class="sidebar-menu">
                <li class="sidebar-item">
                    <a asp-controller="DoctorDashboard" asp-action="Index" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" && ViewContext.RouteData.Values["Controller"].ToString() == "DoctorDashboard" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="DoctorDashboard" asp-action="Appointments" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Appointments" && ViewContext.RouteData.Values["Controller"].ToString() == "DoctorDashboard" ? "active" : "")">
                        <i class="bi bi-calendar-check"></i>
                        <span>Appointments</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="DoctorDashboard" asp-action="Patients" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Patients" && ViewContext.RouteData.Values["Controller"].ToString() == "DoctorDashboard" ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>Patients</span>
                    </a>
                </li>

                <div class="sidebar-divider"></div>
                <div class="sidebar-heading">Settings</div>

                <li class="sidebar-item">
                    <a asp-controller="DoctorDashboard" asp-action="Profile" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Profile" && ViewContext.RouteData.Values["Controller"].ToString() == "DoctorDashboard" ? "active" : "")">
                        <i class="bi bi-person-circle"></i>
                        <span>My Profile</span>
                    </a>
                </li>
                <li class="sidebar-item">
                    <a asp-controller="DoctorDashboard" asp-action="Schedule" class="sidebar-link @(ViewContext.RouteData.Values["Action"].ToString() == "Schedule" && ViewContext.RouteData.Values["Controller"].ToString() == "DoctorDashboard" ? "active" : "")">
                        <i class="bi bi-calendar-week"></i>
                        <span>My Schedule</span>
                    </a>
                </li>
            </ul>

            <button id="sidebarToggle" class="sidebar-toggle">
                <i class="bi bi-chevron-left"></i>
            </button>
        </aside>

        <!-- Content -->
        <div class="content">
            <!-- Topbar -->
            <header class="topbar">
                <button id="mobileToggle" class="mobile-toggle">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-search d-none d-lg-block">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Search...">
                        <button class="btn" type="button">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </div>

                <div class="topbar-nav ms-auto">
                    <div class="topbar-item">
                        <a href="#" class="topbar-link" data-bs-toggle="dropdown">
                            <i class="bi bi-bell"></i>
                            <span class="badge bg-danger badge-counter">3</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end shadow-sm">
                            <h6 class="dropdown-header">Notifications</h6>
                            <a class="dropdown-item" href="#">New appointment</a>
                            <a class="dropdown-item" href="#">Rescheduled appointment</a>
                            <a class="dropdown-item" href="#">Cancelled appointment</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item text-center" href="#">View all</a>
                        </div>
                    </div>

                    <div class="topbar-divider d-none d-sm-block"></div>

                    <div class="topbar-item dropdown">
                        <a href="#" class="user-dropdown" data-bs-toggle="dropdown">
                            <img src="https://via.placeholder.com/150" alt="User" class="user-avatar">
                            <div class="user-info d-none d-sm-block">
                                <div class="user-name">Dr. @User.Identity.Name</div>
                                <div class="user-role">Doctor</div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end shadow-sm">
                            <a class="dropdown-item" asp-controller="DoctorDashboard" asp-action="Profile">
                                <i class="bi bi-person me-2"></i> Profile
                            </a>
                            <a class="dropdown-item" asp-controller="DoctorDashboard" asp-action="Settings">
                                <i class="bi bi-gear me-2"></i> Settings
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#logoutModal">
                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Content -->
            <main class="main-content">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer">
                <div class="container">
                    <span>Copyright &copy; AppointPro @DateTime.Now.Year</span>
                </div>
            </footer>
        </div>
    </div>

    <!-- Logout Modal -->
    <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="logoutModalLabel">Ready to Leave?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Select "Logout" below if you are ready to end your current session.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-primary">Logout</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Sidebar toggle
            const layoutWrapper = document.getElementById('layoutWrapper');
            const sidebarToggle = document.getElementById('sidebarToggle');
            const mobileToggle = document.getElementById('mobileToggle');
            const sidebarIcon = sidebarToggle.querySelector('i');

            // Check for saved state
            const sidebarState = localStorage.getItem('sidebarState');
            if (sidebarState === 'collapsed') {
                layoutWrapper.classList.add('sidebar-collapsed');
                sidebarIcon.classList.remove('bi-chevron-left');
                sidebarIcon.classList.add('bi-chevron-right');
            }

            sidebarToggle.addEventListener('click', function() {
                layoutWrapper.classList.toggle('sidebar-collapsed');
                
                if (layoutWrapper.classList.contains('sidebar-collapsed')) {
                    sidebarIcon.classList.remove('bi-chevron-left');
                    sidebarIcon.classList.add('bi-chevron-right');
                    localStorage.setItem('sidebarState', 'collapsed');
                } else {
                    sidebarIcon.classList.remove('bi-chevron-right');
                    sidebarIcon.classList.add('bi-chevron-left');
                    localStorage.setItem('sidebarState', 'expanded');
                }
            });

            mobileToggle.addEventListener('click', function() {
                document.body.classList.toggle('mobile-menu-open');
            });

            // Close sidebar when clicking outside on mobile
            document.addEventListener('click', function(event) {
                if (document.body.classList.contains('mobile-menu-open') && 
                    !event.target.closest('.sidebar') && 
                    !event.target.closest('#mobileToggle')) {
                    document.body.classList.remove('mobile-menu-open');
                }
            });

            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>