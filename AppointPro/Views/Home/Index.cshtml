@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <h1 class="display-4 fw-bold mb-3 text-gradient">Your Health, Our Priority</h1>
                <p class="lead mb-4">AppointPro+ makes healthcare accessible with easy appointment booking, medical records management, and seamless doctor consultations.</p>
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Hospital" asp-action="Index" class="btn btn-primary btn-lg">
                        <i class="bi bi-hospital me-2"></i>Find Hospitals
                    </a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-lg">
                        <i class="bi bi-calendar-plus me-2"></i>Book Appointment
                    </a>
                </div>
                <div class="stats-row d-flex flex-wrap">
                    <div class="stat-item me-4 mb-3">
                        <div class="stat-number">500+</div>
                        <div class="stat-label">Doctors</div>
                    </div>
                    <div class="stat-item me-4 mb-3">
                        <div class="stat-number">50+</div>
                        <div class="stat-label">Hospitals</div>
                    </div>
                    <div class="stat-item mb-3">
                        <div class="stat-number">24/7</div>
                        <div class="stat-label">Support</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="https://img.freepik.com/free-vector/doctors-concept-illustration_114360-1515.jpg" alt="Healthcare Illustration" class="hero-image img-fluid rounded-4 shadow">
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section py-5 bg-light">
    <div class="container">
        <h2 class="text-center fw-bold mb-5 text-gradient">Why Choose AppointPro+</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon bg-primary-soft">
                        <i class="bi bi-calendar2-check"></i>
                    </div>
                    <h3 class="feature-title">Easy Appointment Booking</h3>
                    <p class="feature-text">Schedule, reschedule, or cancel appointments with top doctors in just a few clicks.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon bg-success-soft">
                        <i class="bi bi-file-earmark-medical"></i>
                    </div>
                    <h3 class="feature-title">Medical Records Access</h3>
                    <p class="feature-text">Access your prescriptions, lab reports, and doctor notes securely—anytime, anywhere.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card h-100">
                    <div class="feature-icon bg-info-soft">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <h3 class="feature-title">Pharmacy Integration</h3>
                    <p class="feature-text">Order prescribed medicines online and track your delivery with ease.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Top Doctors Section -->
<section class="doctors-section py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-5 text-gradient">Meet Our Top Doctors</h2>
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="doctor-card">
                    <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="Dr. Alice Johnson" class="doctor-img">
                    <div class="doctor-info">
                        <h4 class="doctor-name">Dr. Alice Johnson</h4>
                        <p class="doctor-specialty">Cardiology</p>
                        <div class="doctor-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-half"></i>
                            <span>4.8</span>
                        </div>
                        <p class="doctor-hospital">Mayo Clinic</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="doctor-card">
                    <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="Dr. Robert Smith" class="doctor-img">
                    <div class="doctor-info">
                        <h4 class="doctor-name">Dr. Robert Smith</h4>
                        <p class="doctor-specialty">Neurology</p>
                        <div class="doctor-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star"></i>
                            <span>4.0</span>
                        </div>
                        <p class="doctor-hospital">Cleveland Clinic</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="doctor-card">
                    <img src="https://randomuser.me/api/portraits/women/68.jpg" alt="Dr. Priya Patel" class="doctor-img">
                    <div class="doctor-info">
                        <h4 class="doctor-name">Dr. Priya Patel</h4>
                        <p class="doctor-specialty">Pediatrics</p>
                        <div class="doctor-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-half"></i>
                            <span>4.5</span>
                        </div>
                        <p class="doctor-hospital">Johns Hopkins</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="doctor-card">
                    <img src="https://randomuser.me/api/portraits/men/65.jpg" alt="Dr. Michael Lee" class="doctor-img">
                    <div class="doctor-info">
                        <h4 class="doctor-name">Dr. Michael Lee</h4>
                        <p class="doctor-specialty">Orthopedics</p>
                        <div class="doctor-rating">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star"></i>
                            <span>4.2</span>
                        </div>
                        <p class="doctor-hospital">Mass General</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-4">
            <a href="#" class="btn btn-primary btn-lg">View All Doctors</a>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="how-it-works-section py-5 bg-light">
    <div class="container">
        <h2 class="text-center fw-bold mb-5 text-gradient">How It Works</h2>
        <div class="row g-4">
            <div class="col-md-3">
                <div class="step-card text-center">
                    <div class="step-number">1</div>
                    <div class="step-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h4 class="step-title">Create Account</h4>
                    <p class="step-text">Sign up and complete your profile with basic health information</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="step-card text-center">
                    <div class="step-number">2</div>
                    <div class="step-icon">
                        <i class="bi bi-search"></i>
                    </div>
                    <h4 class="step-title">Find Doctor</h4>
                    <p class="step-text">Search for specialists by location, specialty, or ratings</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="step-card text-center">
                    <div class="step-number">3</div>
                    <div class="step-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <h4 class="step-title">Book Appointment</h4>
                    <p class="step-text">Select a convenient time slot and confirm your booking</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="step-card text-center">
                    <div class="step-number">4</div>
                    <div class="step-icon">
                        <i class="bi bi-clipboard2-pulse"></i>
                    </div>
                    <h4 class="step-title">Get Care</h4>
                    <p class="step-text">Visit the doctor and access your records afterward</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section py-5">
    <div class="container">
        <div class="cta-card text-center p-5">
            <h2 class="fw-bold mb-3">Ready to take control of your healthcare?</h2>
            <p class="lead mb-4">Join thousands of patients who have simplified their healthcare journey with AppointPro+</p>
            <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-5">
                <i class="bi bi-person-plus me-2"></i>Sign Up Now
            </a>
        </div>
    </div>
</section>

<style>
    /* Base Styles */
    section {
        overflow: hidden;
    }
    
    .text-gradient {
        background: linear-gradient(90deg, #4f46e5, #0ea5e9);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    /* Hero Section */
    .hero-section {
        padding: 60px 0;
        background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 50%, #dbeafe 100%);
    }
    
    .hero-image {
        max-height: 500px;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.1);
    }
    
    .stats-row {
        margin-top: 20px;
    }
    
    .stat-item {
        text-align: center;
    }
    
    .stat-number {
        font-size: 2rem;
        font-weight: 700;
        color: #4f46e5;
    }
    
    .stat-label {
        font-size: 0.9rem;
        color: #64748b;
    }
    
    /* Features Section */
    .features-section {
        background-color: #f8fafc;
    }
    
    .feature-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }
    
    .feature-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .feature-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 2rem;
    }
    
    .bg-primary-soft {
        background-color: rgba(79, 70, 229, 0.1);
        color: #4f46e5;
    }
    
    .bg-success-soft {
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }
    
    .bg-info-soft {
        background-color: rgba(14, 165, 233, 0.1);
        color: #0ea5e9;
    }
    
    .feature-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 15px;
    }
    
    .feature-text {
        color: #64748b;
        margin-bottom: 0;
    }
    
    /* Doctors Section */
    .doctors-section {
        padding: 60px 0;
    }
    
    .doctor-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        transition: all 0.3s ease;
    }
    
    .doctor-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .doctor-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }
    
    .doctor-info {
        padding: 20px;
    }
    
    .doctor-name {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 5px;
    }
    
    .doctor-specialty {
        color: #4f46e5;
        font-weight: 500;
        margin-bottom: 10px;
    }
    
    .doctor-rating {
        color: #f59e0b;
        margin-bottom: 10px;
    }
    
    .doctor-rating span {
        color: #64748b;
        margin-left: 5px;
    }
    
    .doctor-hospital {
        color: #64748b;
        font-size: 0.9rem;
        margin-bottom: 0;
    }
    
    /* How It Works Section */
    .how-it-works-section {
        background-color: #f8fafc;
    }
    
    .step-card {
        background: white;
        border-radius: 16px;
        padding: 30px 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
        position: relative;
        transition: all 0.3s ease;
    }
    
    .step-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .step-number {
        position: absolute;
        top: -15px;
        left: 50%;
        transform: translateX(-50%);
        width: 30px;
        height: 30px;
        background: linear-gradient(135deg, #4f46e5, #0ea5e9);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }
    
    .step-icon {
        font-size: 2.5rem;
        color: #4f46e5;
        margin-bottom: 15px;
    }
    
    .step-title {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 10px;
    }
    
    .step-text {
        color: #64748b;
        margin-bottom: 0;
    }
    
    /* CTA Section */
    .cta-section {
        padding: 60px 0;
    }
    
    .cta-card {
        background: linear-gradient(135deg, #4f46e5 0%, #0ea5e9 100%);
        border-radius: 16px;
        color: white;
        box-shadow: 0 15px 35px rgba(79, 70, 229, 0.2);
    }
    
    .cta-card .btn-primary {
        background: white;
        color: #4f46e5;
        border: none;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    
    .cta-card .btn-primary:hover {
        background: rgba(255,255,255,0.9);
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }
    
    /* Responsive Adjustments */
    @@media (max-width: 992px) {
        .hero-section {
            text-align: center;
        }
        
        .stats-row {
            justify-content: center;
        }
    }
    
    @@media (max-width: 768px) {
        .hero-section {
            padding: 40px 0;
        }
        
        .step-card {
            margin-bottom: 30px;
        }
    }
</style>