@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg, #e0eafc 0%, #cfdef3 100%);
            min-height: 100vh;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            border-radius: 1.5rem;
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.18);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            animation: floatIn 1s cubic-bezier(.68, -0.55, .27, 1.55);
        }

        @@keyframes floatIn {
            0% {
                transform: translateY(40px) scale(0.95);
                opacity: 0;
            }

            100% {
                transform: translateY(0) scale(1);
                opacity: 1;
            }
        }

        .google-btn {
            background: #fff;
            color: #444;
            border: 1px solid #ddd;
            font-weight: 500;
            transition: box-shadow 0.2s, color 0.2s, border-color 0.2s;
        }

            .google-btn:hover {
                box-shadow: 0 2px 8px rgba(66, 133, 244, 0.15);
                border-color: #4285f4;
                color: #4285f4;
            }

        .google-icon {
            width: 22px;
            height: 22px;
            margin-right: 10px;
            vertical-align: middle;
        }
    </style>
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="glass-card p-4" style="width: 370px;">
        <div class="text-center mb-4">
            <img src="https://cdn-icons-png.flaticon.com/512/3177/3177361.png" alt="User" width="64" class="mb-2" />
            <h3 class="fw-bold mb-1" style="letter-spacing:1px;">Welcome to AppointPro</h3>
            <div class="text-muted mb-2" style="font-size:1rem;">Sign in to continue</div>
        </div>
        <div class="d-grid mb-3">
            <a asp-action="GoogleLogin" class="btn google-btn btn-lg">
                <img class="google-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" alt="Google" />
                Sign in with Google
            </a>
        </div>
        <hr />
        <p class="text-center text-muted mb-0" style="font-size: 0.92rem;">
            By signing in, you agree to our <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.
        </p>
    </div>
</div>