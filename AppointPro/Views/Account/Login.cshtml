@model AppointPro.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

@section Styles {
        <style>
            body {
                background: linear-gradient(135deg, #e0eafc 0%, #cfdef3 100%);
                min-height: 100vh;
            }

            .glass-card {
                background: rgba(255, 255, 255, 0.85);
                border-radius: 1.5rem;
                box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.18);
                backdrop-filter: blur(8px);
                border: 1px solid rgba(255, 255, 255, 0.18);
                animation: floatIn 1s cubic-bezier(.68, -0.55, .27, 1.55);
            }

            @@keyframes floatIn {
                0% {
                    transform: translateY(40px) scale(0.95);
                    opacity: 0;
                }

                100% {
                    transform: translateY(0) scale(1);
                    opacity: 1;
                }
            }

            .google-btn {
                background: #fff;
                color: #444;
                border: 1px solid #ddd;
                font-weight: 500;
                transition: box-shadow 0.2s, color 0.2s, border-color 0.2s;
            }

                .google-btn:hover {
                    box-shadow: 0 2px 8px rgba(66, 133, 244, 0.15);
                    border-color: #4285f4;
                    color: #4285f4;
                }

            .google-icon {
                width: 22px;
                height: 22px;
                margin-right: 10px;
                vertical-align: middle;
            }

            .form-floating {
                margin-bottom: 1rem;
            }

            .divider {
                display: flex;
                align-items: center;
                text-align: center;
                margin: 1.5rem 0;
            }

            .divider::before,
            .divider::after {
                content: '';
                flex: 1;
                border-bottom: 1px solid #ddd;
            }

            .divider::before {
                margin-right: 1rem;
            }

            .divider::after {
                margin-left: 1rem;
            }

            .role-selector {
                display: flex;
                margin-bottom: 1.5rem;
            }

            .role-option {
                flex: 1;
                text-align: center;
                padding: 1rem;
                border: 2px solid #ddd;
                border-radius: 0.75rem;
                margin: 0 0.5rem;
                cursor: pointer;
                transition: all 0.3s ease;
            }

            .role-option:hover {
                border-color: var(--primary-color);
                background-color: rgba(99, 102, 241, 0.05);
            }

            .role-option.active {
                border-color: var(--primary-color);
                background-color: rgba(99, 102, 241, 0.1);
            }

            .role-option i {
                font-size: 2rem;
                margin-bottom: 0.5rem;
                color: var(--primary-color);
            }

            .role-radio {
                position: absolute;
                opacity: 0;
            }
        </style>
}

<div class="d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="glass-card p-4" style="width: 420px;">
        <div class="text-center mb-4">
            <img src="https://cdn-icons-png.flaticon.com/512/3177/3177361.png" alt="User" width="64" class="mb-2" />
            <h3 class="fw-bold mb-1" style="letter-spacing:1px;">Welcome to AppointPro</h3>
            <div class="text-muted mb-2" style="font-size:1rem;">Sign in to continue</div>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="role-selector">
                <label class="role-option" id="patient-role">
                    <input asp-for="Role" type="radio" value="Patient" class="role-radio" checked />
                    <i class="bi bi-person"></i>
                    <div>Patient</div>
                </label>
                <label class="role-option" id="doctor-role">
                    <input asp-for="Role" type="radio" value="Doctor" class="role-radio" />
                    <i class="bi bi-clipboard2-pulse"></i>
                    <div>Doctor</div>
                </label>
                <label class="role-option" id="admin-role">
                    <input asp-for="Role" type="radio" value="SystemAdmin" class="role-radio" />
                    <i class="bi bi-shield-lock"></i>
                    <div>Admin</div>
                </label>
            </div>

            <div class="form-floating">
                <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                <label asp-for="Email">Email address</label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-floating">
                <input asp-for="Password" class="form-control" type="password" placeholder="Password" />
                <label asp-for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-primary btn-lg">Sign In</button>
            </div>

            <div class="text-center mt-3">
                <a href="#" class="text-decoration-none">Forgot password?</a>
            </div>
        </form>

        <div class="divider">OR</div>

        <div class="d-grid mb-3">
            <a asp-action="GoogleLogin" class="btn google-btn btn-lg">
                <img class="google-icon" src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" alt="Google" />
                Sign in with Google
            </a>
        </div>

        <div class="text-center mt-3">
            <span>Don't have an account?</span>
            <a asp-action="Register" class="text-decoration-none ms-1">Sign up</a>
        </div>

        <hr />
        <p class="text-center text-muted mb-0" style="font-size: 0.92rem;">
            By signing in, you agree to our <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.
        </p>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const roleOptions = document.querySelectorAll('.role-option');
                const roleRadios = document.querySelectorAll('.role-radio');

                roleOptions.forEach(option => {
                    option.addEventListener('click', function () {
                        // Remove active class from all options
                        roleOptions.forEach(opt => opt.classList.remove('active'));
                        // Add active class to clicked option
                        this.classList.add('active');
                    });
                });

                // Set initial active state based on checked radio
                roleRadios.forEach(radio => {
                    if (radio.checked) {
                        radio.closest('.role-option').classList.add('active');
                    }

                    radio.addEventListener('change', function() {
                        if (this.checked) {
                            roleOptions.forEach(opt => opt.classList.remove('active'));
                            this.closest('.role-option').classList.add('active');
                        }
                    });
                });
            });
        </script>
}